# Скопируйте этот файл в .env (без .example) и заполните реальными
# значениями. Файл .env НЕ должен попадать в git (он уже добавлен в
# .gitignore) — в нём хранятся ваши секреты в открытом виде на диске.

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
TO_EMAILS=mail1@gmail.com, mail2@mail.ru

KEYWORDS=орошени, смет, проект, полив, видеонаблюдени, оргтехник
MY_COMPANY_NAMES=ООО Ромашка

# Не трогайте — это ограничивает локальный запуск только двумя
# площадками, заблокированными для GitHub Actions. Остальные три
# площадки продолжают обрабатываться в облаке.
ONLY_SOURCES=tenders_kg,procurement_kg
